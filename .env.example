# Copy to .env and adjust. All settings are optional.
FLOODWATCH_ADMIN_TOKEN=change-me-to-a-long-random-string
FLOODWATCH_DB=backend/data/floodwatch.db
FLOODWATCH_RATE_LIMIT=12
FLOODWATCH_CORS=http://localhost:5173
# Free CARTO basemap key (dark map style). Without it the app uses OpenStreetMap tiles with a dark filter.
# Get one at https://carto.com/basemaps/apikey  (allow localhost and your Render domain in its settings)
FLOODWATCH_CARTO_KEY=
